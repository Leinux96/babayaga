import { useQuery } from '@tanstack/react-query';
import React, { useEffect, useRef, useState } from 'react';
import {
  Dimensions,
  Modal,
  Pressable,
  SafeAreaView,
  ScrollView,
  StyleSheet,
  Text,
  TextInput,
  View,
} from 'react-native';
import Animated, {
  useAnimatedStyle,
  useSharedValue,
  withDelay,
  withSpring,
} from 'react-native-reanimated';

import { TypewriterText } from '../../components/TypewriterText';
import { fetchTarotReading, type TarotResponse } from '../../core/ai-service';
import { AdBanner, useInterstitialAd } from '../monetization/ad-manager';
import { SubscriptionModal } from '../monetization/subscription-modal';
import { CardComponent } from './card-component';

const { width, height } = Dimensions.get('window');
const CARD_WIDTH = 80;
const CARD_HEIGHT = 120;
const CENTER_X = width / 2 - CARD_WIDTH / 2;
const CENTER_Y = height / 2.5;

// 5 Card Cross Positions (Adjusted for Modal)
const POSITIONS = [
  { x: CENTER_X, y: CENTER_Y, rotate: '0deg' }, // Center (Present)
  { x: CENTER_X, y: CENTER_Y, rotate: '90deg' }, // Cross (Challenge)
  { x: CENTER_X, y: CENTER_Y + CARD_HEIGHT + 20, rotate: '0deg' }, // Below (Foundation)
  { x: CENTER_X, y: CENTER_Y - CARD_HEIGHT - 20, rotate: '0deg' }, // Above (Outcome/Star)
  { x: CENTER_X - CARD_WIDTH - 20, y: CENTER_Y, rotate: '0deg' }, // Left (Past/Guidance)
];

type Message = {
  id: string;
  text: string;
  sender: 'user' | 'seer';
  isTyping?: boolean; // For streaming effect
};

export const TarotTable = () => {
  const [question, setQuestion] = useState('');
  const [messages, setMessages] = useState<Message[]>([
    {
      id: 'init',
      text: 'Ask the cards, and the void shall answer.',
      sender: 'seer',
    },
  ]);
  const [isModalVisible, setIsModalVisible] = useState(false);
  const [currentReading, setCurrentReading] = useState<TarotResponse | null>(
    null
  );
  const [revealedIds, setRevealedIds] = useState<Set<string>>(new Set());
  const [showSubscription, setShowSubscription] = useState(false);

  const scrollViewRef = useRef<ScrollView>(null);
  const { showAd } = useInterstitialAd();

  const { refetch, isFetching } = useQuery({
    queryKey: ['tarot', question],
    queryFn: () => fetchTarotReading(question),
    enabled: false,
  });

  const handleConsult = async () => {
    if (!question.trim()) return;

    // add user message
    const userMsg: Message = {
      id: Date.now().toString(),
      text: question,
      sender: 'user',
    };
    setMessages((prev) => [...prev, userMsg]);
    setQuestion('');

    // Show Ad
    showAd();

    // Fetch AI
    const result = await refetch();

    if (result.data) {
      setCurrentReading(result.data);
      // Add First Answer
      const answerMsg: Message = {
        id: Date.now().toString() + '_1',
        text: result.data.first_answer,
        sender: 'seer',
      };
      setMessages((prev) => [...prev, answerMsg]);

      // Open Modal after slight delay
      setTimeout(() => {
        setRevealedIds(new Set()); // Reset revealed
        setIsModalVisible(true);
      }, 1500);
    }
  };

  const handleCardPress = (cardId: string) => {
    setRevealedIds((prev) => {
      const next = new Set(prev);
      next.add(cardId);
      return next;
    });
  };

  // Check if all cards revealed
  useEffect(() => {
    if (
      isModalVisible &&
      currentReading &&
      revealedIds.size === currentReading.cards_pulled.length
    ) {
      // All revealed.
      // Optional: Auto close or show button? User requirement: "User clicks to flip them, then returns to chat"
      // Let's verify with a "Continue" button or auto-close delay?
      // "outcome is shown in text chat"
      // Let's add a small delay then show a button to close, or auto close.
      // Auto close feels smoother.
      /*
          setTimeout(() => {
              handleCloseModal();
          }, 2000); 
          */
    }
  }, [revealedIds, isModalVisible]);

  const handleCloseModal = () => {
    setIsModalVisible(false);
    // Add Outcome message with streaming
    if (currentReading) {
      const outcomeMsg: Message = {
        id: Date.now().toString() + '_outcome',
        text: currentReading.outcome,
        sender: 'seer',
        isTyping: true,
      };
      setMessages((prev) => [...prev, outcomeMsg]);
    }
  };

  return (
    <SafeAreaView style={styles.container}>
      <View style={styles.header}>
        <Text style={styles.title}>The Seer</Text>
        <Pressable
          onPress={() => setShowSubscription(true)}
          style={styles.proButton}
        >
          <Text style={styles.proText}>REMOVE ADS</Text>
        </Pressable>
      </View>

      <ScrollView
        ref={scrollViewRef}
        style={styles.chatArea}
        contentContainerStyle={styles.chatContent}
        onContentSizeChange={() =>
          scrollViewRef.current?.scrollToEnd({ animated: true })
        }
      >
        {messages.map((msg) => (
          <View
            key={msg.id}
            style={[
              styles.bubble,
              msg.sender === 'user' ? styles.userBubble : styles.seerBubble,
            ]}
          >
            {msg.isTyping ? (
              <TypewriterText text={msg.text} style={styles.bubbleText} />
            ) : (
              <Text style={styles.bubbleText}>{msg.text}</Text>
            )}
          </View>
        ))}
        {isFetching && (
          <View style={styles.loadingBubble}>
            <Text style={styles.loadingText}>The cards are shuffling...</Text>
          </View>
        )}
      </ScrollView>

      <View style={styles.inputArea}>
        <TextInput
          style={styles.input}
          placeholder="Ask..."
          placeholderTextColor="#666"
          value={question}
          onChangeText={setQuestion}
          onSubmitEditing={handleConsult}
        />
        <Pressable
          onPress={handleConsult}
          disabled={isFetching}
          style={styles.sendButton}
        >
          <Text style={styles.sendText}>🔮</Text>
        </Pressable>
      </View>

      <AdBanner />
      <SubscriptionModal
        visible={showSubscription}
        onClose={() => setShowSubscription(false)}
      />

      {/* Spread Modal */}
      <Modal visible={isModalVisible} transparent animationType="fade">
        <View style={styles.modalOverlay}>
          <View style={styles.modalContent}>
            <Text style={styles.modalTitle}>Reveal Your Fate</Text>
            <View style={styles.tableArea}>
              {/* Deck Placeholder */}
              <View style={styles.deckPlaceholder} />

              {currentReading?.cards_pulled.map((card, index) => {
                const targetPos = POSITIONS[index] || {
                  x: CENTER_X,
                  y: CENTER_Y,
                  rotate: '0deg',
                };
                return (
                  <DealingCard
                    key={card.id}
                    card={card}
                    index={index}
                    targetX={targetPos.x}
                    targetY={targetPos.y}
                    targetRotate={targetPos.rotate}
                    isRevealed={revealedIds.has(card.id)}
                    onPress={() => handleCardPress(card.id)}
                  />
                );
              })}
            </View>

            {currentReading &&
              revealedIds.size === currentReading.cards_pulled.length && (
                <Pressable
                  style={styles.continueButton}
                  onPress={handleCloseModal}
                >
                  <Text style={styles.continueText}>Complete Reading</Text>
                </Pressable>
              )}
          </View>
        </View>
      </Modal>
    </SafeAreaView>
  );
};

// Wrapper handling the deal animation
const DealingCard = ({
  card,
  index,
  targetX,
  targetY,
  targetRotate,
  isRevealed,
  onPress,
}: any) => {
  const translateX = useSharedValue(width - 50); // Start off-screen (Deck position)
  const translateY = useSharedValue(height - 50);

  useEffect(() => {
    // Dealing animation on mount
    translateX.value = withDelay(index * 300, withSpring(targetX));
    translateY.value = withDelay(index * 300, withSpring(targetY));
  }, []);

  // Parse rotation for wrapper
  const rotationDeg = targetRotate === '90deg' ? '90deg' : '0deg';

  const animatedStyle = useAnimatedStyle(() => {
    return {
      position: 'absolute',
      transform: [
        { translateX: translateX.value },
        { translateY: translateY.value },
        { rotate: rotationDeg },
      ],
      // zIndex hierarchy for Cross
      zIndex: index === 1 ? 20 : 10,
    };
  });

  return (
    <Animated.View style={animatedStyle}>
      <CardComponent
        id={card.id}
        isFlipped={isRevealed}
        onPress={onPress}
        width={CARD_WIDTH}
        height={CARD_HEIGHT}
        frontContent={
          // Optional: Show Name only when flipped? Or always on top?
          // Better to rely on the nice images now.
          // Maybe small text at bottom if needed.
          isRevealed ? (
            <View style={styles.cardLabelContainer}>
              <Text style={styles.cardLabel}>{card.name}</Text>
            </View>
          ) : null
        }
      />
    </Animated.View>
  );
};

const styles = StyleSheet.create({
  container: {
    flex: 1,
    backgroundColor: '#121212',
  },
  header: {
    padding: 15,
    flexDirection: 'row',
    alignItems: 'center',
    justifyContent: 'space-between',
    borderBottomWidth: 1,
    borderBottomColor: '#333',
  },
  title: {
    fontSize: 20,
    color: '#D4Af37',
    fontWeight: 'bold',
    fontFamily: 'serif',
  },
  proButton: {
    borderWidth: 1,
    borderColor: '#D4Af37',
    padding: 5,
    borderRadius: 5,
  },
  proText: {
    color: '#D4Af37',
    fontSize: 10,
    fontWeight: 'bold',
  },
  chatArea: {
    flex: 1,
  },
  chatContent: {
    padding: 15,
    gap: 10,
  },
  bubble: {
    padding: 15,
    borderRadius: 15,
    maxWidth: '85%',
  },
  userBubble: {
    backgroundColor: '#333',
    alignSelf: 'flex-end',
    borderBottomRightRadius: 2,
  },
  seerBubble: {
    backgroundColor: '#1a1a2e',
    borderWidth: 1,
    borderColor: '#D4Af37',
    alignSelf: 'flex-start',
    borderBottomLeftRadius: 2,
  },
  bubbleText: {
    color: '#eee',
    fontSize: 16,
    lineHeight: 22,
  },
  loadingBubble: {
    padding: 10,
    alignSelf: 'flex-start',
  },
  loadingText: {
    color: '#888',
    fontStyle: 'italic',
  },
  inputArea: {
    flexDirection: 'row',
    padding: 10,
    borderTopWidth: 1,
    borderTopColor: '#333',
    backgroundColor: '#1a1a1a',
  },
  input: {
    flex: 1,
    backgroundColor: '#333',
    borderRadius: 20,
    paddingHorizontal: 15,
    color: 'white',
    marginRight: 10,
    height: 40,
  },
  sendButton: {
    justifyContent: 'center',
    alignItems: 'center',
    width: 40,
    height: 40,
    backgroundColor: '#D4Af37',
    borderRadius: 20,
  },
  sendText: {
    fontSize: 16,
  },
  // Modal Styles
  modalOverlay: {
    flex: 1,
    backgroundColor: 'rgba(0,0,0,0.95)',
    justifyContent: 'center',
  },
  modalContent: {
    flex: 1,
  },
  modalTitle: {
    textAlign: 'center',
    color: '#D4Af37',
    fontSize: 24,
    marginTop: 60,
    fontFamily: 'serif',
    fontWeight: 'bold',
  },
  tableArea: {
    flex: 1,
    // position: 'relative',
  },
  deckPlaceholder: {
    position: 'absolute',
    bottom: 40,
    right: 20,
    width: CARD_WIDTH,
    height: CARD_HEIGHT,
    backgroundColor: '#222',
    borderRadius: 8,
    borderWidth: 1,
    borderColor: '#444',
  },
  continueButton: {
    position: 'absolute',
    bottom: 50,
    alignSelf: 'center',
    backgroundColor: '#D4Af37',
    paddingVertical: 15,
    paddingHorizontal: 40,
    borderRadius: 30,
    zIndex: 100,
  },
  continueText: {
    fontWeight: 'bold',
    fontSize: 18,
    color: 'black',
  },
  cardLabelContainer: {
    position: 'absolute',
    bottom: 5,
    left: 0,
    right: 0,
    backgroundColor: 'rgba(0,0,0,0.7)',
    padding: 2,
    borderRadius: 4,
  },
  cardLabel: {
    color: 'white',
    fontSize: 10,
    textAlign: 'center',
  },
});
